# 豆包大模型 / 火山引擎 ARK 配置
ARK_API_KEY=your_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seedream-5-0-260128

# 图片工具配置
IMAGE_PROVIDER=doubao
IMAGE_OUTPUT_DIR=./output
IMAGE_UPLOAD_DIR=./uploads

# Moebius 本地 inpainting 模型配置
# 启用后，inpaint 任务会优先路由到 Moebius
# 如缺少 torch/diffusers 等依赖，可运行: uv sync --extra local-moebius
MOEBIUS_ENABLED=false
MOEBIUS_HOME=/path/to/Moebius          # Moebius 仓库根目录（需 git clone）
MOEBIUS_WEIGHT_DIR=~/models/Moebius    # 模型权重目录，下含 pretrained/、ft_places2/ 等子目录
MOEBIUS_VARIANT=pretrained             # pretrained / ft_places2 / ft_celebahq / ft_ffhq
MOEBIUS_VAE_WEIGHT=~/models/vae         # 留空则自动从 weight_dir 推断
MOEBIUS_MODEL_CONFIG=                  # 留空则使用默认 config/model_cfg/moebius.yaml
MOEBIUS_DEVICE=cuda
MOEBIUS_RESOLUTION=512
MOEBIUS_NUM_STEPS=20
MOEBIUS_CFG=2.5

# LaMa 物体移除模型配置
# 启用后，inpaint 任务会路由到 LaMa（需先安装依赖：uv sync --extra local-lama）
LAMA_ENABLED=false

# 数据库配置
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/image_editor

# Redis 配置（任务队列）
REDIS_URL=redis://localhost:6379/0

# 调试模式
DEBUG=false

# ollama 本地模型配置
# 启用后，prompt_enhance 任务会优先路由到本地 ollama 模型
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# 文本 LLM 候选顺序（逗号分隔，第一个优先；默认 ollama,doubao）
TEXT_LLM_ORDER=ollama,doubao

# ── Agentic 多步编辑配置 ──────────────────────────────────────────────────────
# 启用后，agentic/auto 模式会使用规划模型自主拆解多步编辑
AGENTIC_EDIT_ENABLED=false
AGENTIC_MODEL=openai:doubao-seed-1-6-250615
AGENTIC_MAX_TURNS=5
AGENTIC_MAX_TOOL_CALLS=8
VISION_MODEL=openai:doubao-1-5-vision-pro-32k-250115
AGENTIC_CONSECUTIVE_FAIL_LIMIT=3
AGENTIC_DEMO_ENABLED=true
AGENTIC_DEMO_MAX_STEPS=6
AGENTIC_PREFERENCE_ENABLED=true
AGENTIC_PREFERENCE_MIN_TURNS=3
