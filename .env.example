# 豆包大模型 / 火山引擎 ARK 配置
ARK_API_KEY=your_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seedream-5-0-260128

# 图片工具配置
IMAGE_PROVIDER=doubao
IMAGE_OUTPUT_DIR=./output
IMAGE_UPLOAD_DIR=./uploads

# Moebius 本地 inpainting 模型配置
# 启用后，inpaint 任务会优先路由到 Moebius
# 如缺少 torch/diffusers 等依赖，可运行: pip install -e ".[local-moebius]"
MOEBIUS_ENABLED=false
MOEBIUS_HOME=/path/to/Moebius          # Moebius 仓库根目录（需 git clone）
MOEBIUS_WEIGHT_DIR=~/models/Moebius    # 模型权重目录，下含 pretrained/、ft_places2/ 等子目录
MOEBIUS_VARIANT=pretrained             # pretrained / ft_places2 / ft_celebahq / ft_ffhq
MOEBIUS_VAE_WEIGHT=~/models/vae         # 留空则自动从 weight_dir 推断
MOEBIUS_MODEL_CONFIG=                  # 留空则使用默认 config/model_cfg/moebius.yaml
MOEBIUS_DEVICE=cuda
MOEBIUS_RESOLUTION=512
MOEBIUS_NUM_STEPS=20
MOEBIUS_CFG=2.5

# LaMa 物体移除模型配置
# 启用后，inpaint 任务会路由到 LaMa（需先安装依赖：pip install "image-editor[local-lama]"）
LAMA_ENABLED=false

# 数据库配置
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/image_editor

# Redis 配置（任务队列）
REDIS_URL=redis://localhost:6379/0

# 调试模式
DEBUG=false
